<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- 焦点聚焦问题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="焦点聚焦问题"
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="8dp" />

        <!-- 1.1 焦点冗余 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1.1 焦点冗余"
            android:textSize="16sp"
            android:padding="4dp" />

        <Button
            android:id="@+id/button2"
            android:background="#ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- 1.2 焦点过大 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1.2 焦点过大"
            android:textSize="16sp"
            android:padding="4dp" />

        <Button
            android:id="@+id/button_large"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:text="Large Button" />

        <!-- 1.3 焦点过小 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1.3 焦点过小"
            android:textSize="16sp"
            android:padding="4dp" />

        <Button
            android:id="@+id/button_small"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:text="Small Button" />

        <!-- 1.4 未组合聚焦 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1.4 未组合聚焦"
            android:textSize="16sp"
            android:padding="4dp" />


        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/textView_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Label" />

            <Switch
                android:layout_marginStart="12dp"
                android:id="@+id/switchCompat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </androidx.appcompat.widget.LinearLayoutCompat>


        <!-- 1.5 焦点顺序 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1.5 焦点顺序"
            android:textSize="16sp"
            android:padding="4dp" />

        <Button
            android:id="@+id/button_first"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:nextFocusDown="@id/button_third"
            android:text="First" />

        <Button
            android:id="@+id/button_second"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Second" />

        <Button
            android:id="@+id/button_third"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Third" />

        <!-- 1.6 列表控件刷新数据焦点乱跳 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1.6 列表控件刷新数据焦点乱跳"
            android:textSize="16sp"
            android:padding="4dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="200dp" />

        <!-- 播报问题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="播报问题"
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="8dp" />

        <!-- 2.1 文本+开关未组合播报 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2.1 文本+开关未组合播报"
            android:textSize="16sp"
            android:padding="4dp" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:focusableInTouchMode="true"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/textView_text_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Text" />

            <Switch
                android:layout_marginStart="12dp"
                android:id="@+id/switchCompat_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </androidx.appcompat.widget.LinearLayoutCompat>


        <!-- 2.2 文本+复选框未组合播报 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2.2 文本+复选框未组合播报"
            android:textSize="16sp"
            android:padding="4dp" />
        <androidx.appcompat.widget.LinearLayoutCompat
            android:focusableInTouchMode="true"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/textView_text_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Text" />

            <CheckBox
                android:layout_marginStart="12dp"
                android:id="@+id/checkBox_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </androidx.appcompat.widget.LinearLayoutCompat>


        <!-- 2.3 图标+消息未组合播报 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2.3 图标+消息未组合播报"
            android:textSize="16sp"
            android:padding="4dp" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:focusableInTouchMode="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/icon_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_launcher_background" />

            <TextView
                android:padding="6dp"
                android:id="@+id/message_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#D11818"
                android:text="2"
                android:textColor="#fff"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 2.4 图标缺失播报 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2.4 图标缺失播报"
            android:textSize="16sp"
            android:padding="4dp" />

        <ImageView
            android:id="@+id/icon_missing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_launcher_background" />

    </LinearLayout>
</ScrollView>